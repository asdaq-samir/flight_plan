<?xml version="1.0" encoding="utf-8"?>
<!-- The native Android app (docs/NATIVE-ANDROID.md). The network for the
     planner, the gateway and the chart's tiles; whether there is one, for
     the words shown when there is not. No location yet: own ship is a
     later phase. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Only HTTPS: the gateway and the tiles' CDN are, and a plain-HTTP
         request is refused by the system rather than sent. The session's
         cookies are kept by the app itself (CookieStore), so Android's
         backup of the app's data is off. Predictive back (Android 14+):
         the system's back animation, with nothing of our own in its way. -->
    <application
        android:name=".WingtipApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.WingtipMaps"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <!-- One task, one instance: a link tapped in Gmail while the app is
             open comes to the running activity as a new intent
             (MainActivity.onNewIntent) rather than opening a second one. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links (docs/ANDROID.md): the sign-in link emailed to the
                 pilot, and a shared route, open the app rather than Chrome,
                 verified against the site's /.well-known/assetlinks.json
                 once the owner lists this package's signing key there. The
                 host is the build's WINGTIP_HOST (build.gradle.kts). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${wingtipHost}" />
                <data android:pathPrefix="/app/plan" />
                <data android:pathPrefix="/api/auth/magic-link/verify" />
            </intent-filter>
        </activity>
    </application>

</manifest>
