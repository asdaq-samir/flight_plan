    "globals": "^16.4.0",
    "jsdom": "^30.1.2",
    "json-schema-to-typescript": "15.0.4",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
