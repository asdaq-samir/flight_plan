{
  "name": "wingtip-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "types": "openapi-typescript ../planning-service/openapi.json -o src/lib/api/schema.d.ts && openapi-typescript ../springboot-app/openapi.json -o src/lib/api/webapp-schema.d.ts && json2ts -i ../native/contract/engine.schema.json -o src/lib/engine/contract.ts --no-additionalProperties --unreachableDefinitions --bannerComment \"/* Generated by json-schema-to-typescript from native/contract/engine.schema.json (npm run types): change the schema, not this file. */\"",
    "predev": "npm run types",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run types",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "npm run types",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run types",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run types",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
