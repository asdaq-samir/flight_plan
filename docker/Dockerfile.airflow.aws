# syntax=docker/dockerfile:1
# The AWS-hosted Airflow image (see AirflowTaskDefinition in
# infra/cloudformation/template.yaml) -- separate from Dockerfile.airflow
# because that one runs DockerOperator sibling containers over the host's
# Docker socket, which Fargate does not have. This image bakes in only the
# AWS-mode DAG (vfr_pipeline_aws_dag.py, which launches SageMaker Jobs
# instead of sibling containers) and the src/vfr package it imports --
# under /opt/project, not /opt/airflow: the task mounts its EFS home at
# /opt/airflow (AirflowTaskDefinition), which would hide anything baked
# beneath it.
FROM apache/airflow:3.3.1-python3.13

# Constraints URL pinned in Dockerfile.airflow too -- keep both in sync
# with the FROM tag's own version (see that file's own comment).
RUN --mount=type=cache,target=/root/.cache/pip,uid=50000,gid=0 pip install \
    "apache-airflow-providers-amazon" \
    "apache-airflow-providers-standard" \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-3.3.1/constraints-3.13.txt"

ENV AIRFLOW__CORE__DAGS_FOLDER=/opt/project/airflow/dags
ENV AIRFLOW__CORE__LOAD_EXAMPLES=false
ENV PYTHONPATH=/opt/project/src

COPY airflow/dags/vfr_pipeline_aws_dag.py /opt/project/airflow/dags/vfr_pipeline_aws_dag.py
COPY src /opt/project/src
# The build fails if the provider or the registry evaluate and promote
# run in-process cannot be imported. (The DAG itself reads an Airflow
# Variable as it loads, which a build has no database for.)
RUN python -B -c "import vfr.model_registry, airflow.providers.amazon.aws.operators.sagemaker"
