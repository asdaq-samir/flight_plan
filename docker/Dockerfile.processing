# syntax=docker/dockerfile:1
# SageMaker-Processing-Job-shaped: collect / engineer-features only.
# See requirements-processing.txt for why this is a separate image from
# Dockerfile.training rather than one shared "pipeline" image.
FROM python:3.13-slim

WORKDIR /workspace

# Copied at the paths they have in the repo, so the image's list finds
# vfr's own through its -r ../src/requirements.txt.
COPY src/requirements.txt src/
COPY docker/requirements-processing.txt docker/
RUN --mount=type=cache,target=/root/.cache/pip pip install -r docker/requirements-processing.txt

COPY src ./src

RUN useradd -m appuser
USER appuser

ENV PYTHONPATH=/workspace/src
ENTRYPOINT ["python3", "-m", "vfr.pipeline"]
