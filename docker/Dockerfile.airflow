# syntax=docker/dockerfile:1
# Lighter than it used to be: collect/engineer_features/retrain now run in
# separate sibling containers (Dockerfile.processing/.training, launched via
# DockerOperator over the mounted host Docker socket -- the local mirror of
# "Airflow orchestrates, SageMaker does the compute"), so this image no
# longer needs pandas/scikit-learn/etc. itself. evaluate/promote still run
# in-process here (ShortCircuitOperator/PythonOperator in the DAG) since
# they're plain file/JSON operations with zero third-party dependencies --
# not real compute, so they don't need their own container either.
FROM apache/airflow:3.3.1-python3.13

# apache-airflow-providers-standard: Airflow 3 split PythonOperator,
# ShortCircuitOperator etc. out of airflow-core into this provider --
# it's a hard dependency now, not an extra.
#
# The constraints URL below is pinned in Dockerfile.airflow.aws too --
# bump the FROM tag's own version here and that file needs the same
# constraints-<version> update, or the two images end up resolving
# different provider versions against the same DAGs.
RUN --mount=type=cache,target=/root/.cache/pip,uid=50000,gid=0 pip install \
    "apache-airflow-providers-docker" \
    "apache-airflow-providers-standard" \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-3.3.1/constraints-3.13.txt"

# The DAGs and the vfr package they import (evaluate/promote run
# in-process), baked in rather than read from the repo. This container
# holds the host's Docker socket, and the repo is mounted read-write
# into ml, both pipeline jobs, planning-service and both agents -- so a
# DAG or module read from it ran, next to the socket, whatever any of
# those had written. /opt/project, not under /opt/airflow: the
# airflow_home_v3 volume mounted there would hide anything copied
# beneath it. A DAG edit therefore needs `docker compose build airflow`.
# Only this DAG: the AWS one needs the amazon provider and its S3 bucket
# Variable, and here it only ever showed as an import error.
ENV AIRFLOW__CORE__DAGS_FOLDER=/opt/project/airflow/dags
ENV PYTHONPATH=/opt/project/src
COPY airflow/dags/vfr_pipeline_dag.py /opt/project/airflow/dags/vfr_pipeline_dag.py
COPY src /opt/project/src
# The build fails if the DAG does not load here -- a provider or a vfr
# import missing -- rather than Airflow listing an import error later.
# (The host path and the project name are compose's to give; any will do
# for loading.)
RUN PROJECT_HOST_PATH=/build-check PIPELINE_IMAGE_PREFIX=build-check python -B -c "from airflow.dag_processing.dagbag import DagBag; bag = DagBag('/opt/project/airflow/dags'); assert not bag.import_errors, bag.import_errors; assert set(bag.dags) == {'vfr_pipeline'}, set(bag.dags)"
