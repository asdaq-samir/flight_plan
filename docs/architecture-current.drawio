        <mxCell id="claude-uses" value='&lt;b&gt;what the planner asks Claude&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;the written briefing (messages.stream, NDJSON)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;checkpoint notes · words with sources · mock oral&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;the assistant (tool runner over the planner)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A5BC2;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="240" width="300" height="100" as="geometry" /></mxCell>
