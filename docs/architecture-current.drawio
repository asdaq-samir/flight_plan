        <mxCell id="android" value='&lt;b&gt;Android&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;Compose · JNI over wt_call&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8C93;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="112" width="140" height="70" as="geometry" /></mxCell>
        <mxCell id="webapp" value='&lt;b&gt;webapp — Spring Boot&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;accounts · sign-in · saved records · public API · scheduled mail&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;should hold no aviation logic; Java currency rules remain (#482)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9A5C;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="270" width="460" height="64" as="geometry" /></mxCell>
        <mxCell id="planning-service" value='&lt;b&gt;planning-service — FastAPI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;over src/wingtip: works out a flight&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;FAA + weather data · charts · chart model (in-process) · checkpoints · nav log · briefing · assistant&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;asks the engine every rule&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9A5C;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="370" width="290" height="130" as="geometry" /></mxCell>
