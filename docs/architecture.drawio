        <mxCell id="box10" value="Combine&#10;notebook 08&#10;FAR 91.159 rounding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBF8EF;strokeColor=#8B6C3E;strokeWidth=2;fontColor=#26221B;fontSize=13;fontStyle=1;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="380" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- e5-e8's stem heights are staggered (305/325/345/365), not all
             at one height: with a shared height, a long horizontal run
             (e.g. e5's or e8's) sweeps straight through a shorter one's
             label (e.g. e6's or e7's) sitting at the same y. -->
        <mxCell id="e5" value="floor (ft MSL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C31F6E;strokeWidth=1.4;fontSize=10;fontColor=#6E6656;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.28;entryY=0;" edge="1" parent="1" source="box6" target="box10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="115" y="305" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="ceiling (ft MSL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C31F6E;strokeWidth=1.4;fontSize=10;fontColor=#6E6656;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="box7" target="box10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="488" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="freezing level · hazards" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C31F6E;strokeWidth=1.4;fontSize=10;fontColor=#6E6656;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="box8" target="box10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="861" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="service ceiling" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C31F6E;strokeWidth=1.4;fontSize=10;fontColor=#6E6656;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="box9" target="box10">
          <mxGeometry relative="1" as="geometry">
